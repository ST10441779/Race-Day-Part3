@{
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName");
    var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("UserId"));
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - RaceDay</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/RaceDay.Mvc.styles.css"
          asp-append-version="true" />
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
            <div class="container">

                <a class="navbar-brand raceday-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <span class="brand-icon">RD</span>

                    <span>
                        RACE<span class="brand-orange">DAY</span>
                        <small>YOUR RACE. YOUR JOURNEY.</small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">

                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        @if (role == "Organiser")
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Organiser" && ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")"
                                   asp-controller="Organiser"
                                   asp-action="Dashboard">
                                    Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Events">
                                    My Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    Profile
                                </a>
                            </li>
                        }
                        else if (role == "Participant")
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Index">
                                    Explore Events
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="MyResults">
                                    My Results
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Profile">
                                    My Profile
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Home"
                                   asp-action="Index">
                                    Home
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Index">
                                    Explore Events
                                </a>
                            </li>
                        }

                        @if (isLoggedIn)
                        {
                            <li class="nav-item ms-lg-3">
                                <span class="user-welcome">
                                    Hello, @(string.IsNullOrWhiteSpace(fullName)
                                                                    ? "User"
                                                                    : fullName.Split(' ')[0])
                            </span>
                        </li>

                            <li class="nav-item ms-lg-2">
                                <form asp-controller="Account"
                                      asp-action="Logout"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-logout">
                                        Sign Out
                                    </button>
                                </form>
                            </li>
                                                }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="nav-link"
                                   asp-controller="Account"
                                   asp-action="Login">
                                    Sign In
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-raceday"
                                   asp-controller="Account"
                                   asp-action="Register">
                                    Get Started
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main class="main-content">

        <div class="container">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mt-3"
                     role="alert">
                    @TempData["Success"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mt-3"
                     role="alert">
                    @TempData["Error"]

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert"
                            aria-label="Close">
                    </button>
                </div>
            }

            @RenderBody()

        </div>

    </main>

    <footer class="raceday-footer">
        <div class="container">

            <div class="row align-items-center gy-3">

                <div class="col-md-6">
                    <div class="footer-brand">
                        RACE<span>DAY</span>
                    </div>

                    <p class="mb-0">
                        Every race tells a story. Make yours count.
                    </p>
                </div>

                <div class="col-md-6 text-md-end">
                    <p class="mb-0">
                        &copy; 2026 RaceDay. All rights reserved.
                    </p>
                </div>

            </div>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>