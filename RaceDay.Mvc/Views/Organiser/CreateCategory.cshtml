@model RaceDay.Mvc.Models.CategoryFormViewModel

@{
    ViewData["Title"] = "Add Category";
}

<h2>Add Event Category</h2>
<p class="text-muted">Add an age group or distance category to your event.</p>

<form asp-action="CreateCategory" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="EventId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="Name" class="form-label">Category Name</label>
        <input asp-for="Name" class="form-control"
               placeholder="Example: 10km Open" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CategoryType" class="form-label">Category Type</label>
        <select asp-for="CategoryType" class="form-select">
            <option value="Age">Age Group</option>
            <option value="Distance">Distance</option>
            <option value="Gender">Gender</option>
            <option value="General">General</option>
        </select>
        <span asp-validation-for="CategoryType" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Category</button>
    <a asp-action="Categories"
       asp-route-eventId="@Model.EventId"
       class="btn btn-secondary">Cancel</a>
</form>