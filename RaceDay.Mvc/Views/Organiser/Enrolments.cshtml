@model List<RaceDay.Mvc.Models.EnrolmentViewModel>

@{
    ViewData["Title"] = "Event Enrolments";
    var categories = ViewBag.Categories as List<RaceDay.Mvc.Models.CategoryViewModel>
                     ?? new List<RaceDay.Mvc.Models.CategoryViewModel>();
    var eventId = (Guid)ViewBag.EventId;
}

<h2>Participant Enrolments</h2>
<p class="text-muted">
    Event: <strong>@ViewBag.EventName</strong>
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-action="Events" class="btn btn-outline-secondary">Back to Events</a>
    <a asp-action="Categories"
       asp-route-eventId="@eventId"
       class="btn btn-outline-primary">Manage Categories</a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Total Enrolments</h5>
        <h2>@Model.Count</h2>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        No participants have enrolled in this event yet.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Participant ID</th>
                    <th>Category</th>
                    <th>Enrolment Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var enrolment in Model.OrderBy(x => x.EnrolledAt))
                {
                    var category = categories.FirstOrDefault(
                    x => x.Id == enrolment.CategoryId);

                    <tr>
                        <td><small>@enrolment.ParticipantId</small></td>
                        <td>@(category?.Name ?? "Category unavailable")</td>
                        <td>@enrolment.EnrolledAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                        <td>
                            <span class="badge bg-success">Enrolled</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}