@model List<RaceDay.Mvc.Models.CategoryViewModel>

@{
    ViewData["Title"] = "Event Categories";
    var eventId = (Guid)ViewBag.EventId;
}

<h2 class="mb-2">Event Categories</h2>
<p class="text-muted">Manage categories for: <strong>@ViewBag.EventName</strong></p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-action="CreateCategory"
       asp-route-eventId="@eventId"
       class="btn btn-success">Add Category</a>

    <a asp-action="Events" class="btn btn-outline-secondary">Back to Events</a>

    <a asp-action="Enrolments"
       asp-route-eventId="@eventId"
       class="btn btn-outline-primary">View Enrolments</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">No categories have been added to this event yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Category Name</th>
                    <th>Category Type</th>
                    <th style="width: 190px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.CategoryType</td>
                        <td>
                            <a asp-action="EditCategory"
                               asp-route-eventId="@eventId"
                               asp-route-categoryId="@category.Id"
                               class="btn btn-sm btn-primary">Edit</a>

                            <form asp-action="DeleteCategory"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="eventId" value="@eventId" />
                                <input type="hidden" name="categoryId" value="@category.Id" />
                                <button type="submit"
                                        class="btn btn-sm btn-danger"
                                        onclick="return confirm('Delete this category?')">
                                    Delete
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}